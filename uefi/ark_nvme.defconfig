# NVIDIA's t23x_embedded profile (edk2-nvidia r36.5, Platform/NVIDIA/Tegra/DefConfigs)
# with the boot device switched from eMMC to NVMe. See docs/fast_boot.md.
CONFIG_SOC_T23X=y
CONFIG_BUILD_EMBEDDED=y
CONFIG_PLATFORM_GUID="f98bcf32-fd20-4ba9-ada4-e0406947ca3c"
CONFIG_LOCALNAME="ARK-NVMe"

# The only boot path is an ext4 root on NVMe; nothing else is enumerated.
CONFIG_PCIE=y
CONFIG_NVME=y
CONFIG_FS_EXT4=y
# CONFIG_EMMC is not set
# CONFIG_SDCARD is not set
# CONFIG_SATA is not set
# CONFIG_USB is not set
# CONFIG_FS_FAT is not set
# CONFIG_NVIDIA_DISPLAY is not set
# CONFIG_NETWORKING is not set
# CONFIG_LOGO is not set
# CONFIG_SHELL is not set

# Security as the general profile. The embedded default is an emulated variable
# store that forgets everything at reset; keep the OP-TEE backed persistent one.
CONFIG_SECURITY_TPM_FIRMWARE=y
CONFIG_SECURITY_MM_OPTEE=y
CONFIG_SECURITY_UEFI_SECURE_BOOT=y
CONFIG_SECURITY_HW_RNG=y
CONFIG_SECURITY_PHYSICAL_PRESENCE=y
CONFIG_SECURITY_DISABLE_PHYSICAL_PRESENCE_POST_SECUREBOOT=y
# CONFIG_VARIABLE_EMULATED is not set
CONFIG_VARIABLE_NON_SECURE_SUPPORTED=y

CONFIG_SERIAL_PORT_CONSOLE_TEGRA=y
CONFIG_DEVICETREE=y
CONFIG_SMBIOS_ARM=y
CONFIG_RCM_BOOT_L4T_LAUNCHER=y
# L4TLauncher runs straight from BDS: no boot menu, no timeout.
CONFIG_BOOT_QUICK_BOOT_ENABLED=y
CONFIG_SINGLE_BOOT_L4T_LAUNCHER=y
CONFIG_BOOT_NATIVE_ANDROID_PARTITION_SUPPORT=y
CONFIG_L4T=y

# nv-l4t-bootloader-config.sh reads the BSP version from the ESRT before it runs
# `nvbootctrl verify`; the embedded profile publishes no ESRT and the service
# fails without ever marking the slot good. Same ESRT GUID as the general
# profile; capsule delivery stays off.
CONFIG_FIRMWARE_MANAGEMENT=y
CONFIG_FIRMWARE_MANAGEMENT_DIRECT=y
CONFIG_FMP_SYSTEM_IMAGE_TYPE_ID="bf0d4599-20d4-414e-b2c5-3595b1cda402"
# CONFIG_FIRMWARE_CAPSULE_SUPPORTED is not set
# CONFIG_DEBUG_PRINT_ENABLE_RELEASE is not set
