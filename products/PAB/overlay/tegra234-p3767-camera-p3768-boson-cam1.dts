/*
 * FLIR Boson+ through the ARK Boson Adapter on PAB CAM1 (J25), 2-lane:
 * CSI1_CLK with CSI1_D0/D1. PAB's camera connectors are 15-pin, so the
 * adapter needs a 22-to-15-pin FFC adapter.
 * TCA9546 channel 1, EXT_SYNC on CAM1_MCLK (PP.01).
 */

/dts-v1/;
/plugin/;

#define CAMERA_I2C_MUX_BUS(x)	(0x1E + x)

#define BOSON_PORT_INDEX	1
#define BOSON_SINTERFACE	"serial_b"
#define BOSON_LANE_POLARITY	"6"
#define BOSON_DISCONTINUOUS_CLK	"no"
/* NVCSI's own THS-settle is too short for the Boson on CSI1 (JAJ CAM0). */
#define BOSON_CIL_SETTLETIME	"150"
#define BOSON_SENSOR_SYSFS	"/sys/firmware/devicetree/base/bus@0/i2c@3180000/tca9546@70/i2c@1/boson@6a"
#define BOSON_SYNC_PAD		"extperiph2_clk_pp1"

#include <dt-bindings/tegra234-p3767-0000-common.h>
#include "tegra234-camera-boson.dtsi"

/ {
	overlay-name = "Camera FLIR Boson+ CAM1";
	jetson-header-name = "Jetson 22pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment-boson-i2c@0 {
		target-path = "/";
		__overlay__ {
			bus@0 {
				i2c@3180000 {
					#address-cells = <1>;
					#size-cells = <0>;
					tca9546@70 {
						compatible = "nxp,pca9546";
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0x70>;
						i2c-parent = <&cam_i2c>;
						skip_mux_detect = "yes";
						status = "okay";
						force_bus_start = <CAMERA_I2C_MUX_BUS(0)>;
						i2c@0 {
							status = "okay";
							reg = <0>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;
							/* the flash-time IMX219 default */
							ark_imx219_a@10 {
								status = "disabled";
							};
						};
						i2c@1 {
							status = "okay";
							reg = <1>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;
							ark_imx219_b@10 {
								status = "disabled";
							};

							boson@6a {
								status = "okay";
#include "tegra234-camera-boson-sensor.dtsi"
							};
						};
						i2c@2 {
							status = "okay";
							reg = <2>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;
							ark_imx219_c@10 {
								status = "disabled";
							};
						};
						i2c@3 {
							status = "okay";
							reg = <3>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;
							ark_imx219_d@10 {
								status = "disabled";
							};
						};
					};
				};
			};
		};
	};
};
