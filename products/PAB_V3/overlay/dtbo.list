# Overlays ARK ships for PAB_V3 — the explicit dtbo set built into the image and
# offered by jetson-io. One dtbo basename per line ('#' comments allowed); each
# must have a matching source file in this dir. build.sh disables the stock p3768
# camera overlays and builds exactly this list (plus the BSP's non-camera
# overlays). PAB_V3 uses the dev-kit i2c-mux-gpio wiring, so it ships the dual
# IMX219/IMX477/IMX708 overlays.
tegra234-p3767-camera-p3768-imx219-dual.dtbo
tegra234-p3767-camera-p3768-imx477-dual.dtbo
tegra234-p3767-camera-p3768-imx708-dual.dtbo

# FLIR Hadron EO (OV64B40) through the ARK Hadron Adapter, one overlay per CSI
# port (driver: kernel_overlay nv_ov64b40). The driver has 4-lane tables only;
# see docs/cameras.md.
tegra234-p3767-camera-p3768-hadron-eo-cam0.dtbo
tegra234-p3767-camera-p3768-hadron-eo-cam1.dtbo

# Not a camera overlay: UEFI boot order (see the source file).
ark_boot_order.dtbo
