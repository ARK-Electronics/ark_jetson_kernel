/*
 * FLIR Hadron EO (OV64B40) on PAB_V3 CAM0 (J28), 4-lane:
 * CSI0_CLK with CSI0_D0/D1 then CSI1_D0/D1.
 * I2C mux channel 0, reset CAM0_PWDN (PH.06),
 * EXT_VSYNC on CAM0_MCLK (PP.00).
 */

/dts-v1/;
/plugin/;

#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)
#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)

#define HADRON_EO_PORT_INDEX	0
#define HADRON_EO_LANES		4
#define HADRON_EO_SINTERFACE	"serial_a"
#define HADRON_EO_LANE_POLARITY	"6"
#define HADRON_EO_SENSOR_SYSFS	"/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/hadron_eo@36"
#define HADRON_EO_SYNC_PAD	"extperiph1_clk_pp0"

#include <dt-bindings/tegra234-p3767-0000-common.h>
#include "tegra234-camera-hadron-eo.dtsi"

/ {
	overlay-name = "Camera FLIR Hadron EO CAM0 4-lane";
	jetson-header-name = "Jetson 22pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment-hadron-eo-i2c@0 {
		target-path = "/";
		__overlay__ {
			bus@0 {
				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					i2c-parent = <&cam_i2c>;
					mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;
					i2c@0 {
						status = "okay";
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;
						/* the flash-time IMX219 default */
						rbpcv2_imx219_a@10 {
							status = "disabled";
						};
						hadron_eo@36 {
							status = "okay";
							reset-gpios = <&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
#include "tegra234-camera-hadron-eo-sensor.dtsi"
						};
					};
					i2c@1 {
						status = "okay";
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;
						rbpcv2_imx219_c@10 {
							status = "disabled";
						};
					};
				};
			};
		};
	};
};
