+#ifdef CONFIG_ARCH_TEGRA
+/* Tegra hardware translates PCIe MSI write transactions to a new address
+ * range.  The lower 10-bits of the data (the irq) select a 64KiB page.
+ * The implementation assumes the corresponding IOVA address range has been
+ * reserved in iova_reserve_iommu_regions
+ */
+int iommu_dma_map_msi_pages(struct device *dev, phys_addr_t msi_base, int irq,
+		unsigned int nr_irqs)
+{
+	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
+	int prot = IOMMU_WRITE | IOMMU_NOEXEC | IOMMU_MMIO;
+	phys_addr_t start, end;
+	size_t granule;
+
+	if (!domain || !domain->iova_cookie)
+		return 0;
+
+	/* An MSI cookie, as VFIO uses, has no IOVA domain to take the granule from */
+	granule = cookie_msi_granule(domain->iova_cookie);
+	start = ALIGN_DOWN(msi_base + (phys_addr_t)irq * SZ_64K, granule);
+	end = ALIGN(msi_base + (phys_addr_t)(irq + nr_irqs) * SZ_64K, granule);
+
+	return iommu_map(domain, start, start, end - start, prot, GFP_KERNEL);
+}
+
+void iommu_dma_unmap_msi_pages(struct device *dev, phys_addr_t msi_base,
+		int irq, unsigned int nr_irqs)
+{
+	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
+	phys_addr_t start, end;
+	size_t granule;
+
+	if (!domain || !domain->iova_cookie)
+		return;
+
+	granule = cookie_msi_granule(domain->iova_cookie);
+	start = ALIGN_DOWN(msi_base + (phys_addr_t)irq * SZ_64K, granule);
+	end = ALIGN(msi_base + (phys_addr_t)(irq + nr_irqs) * SZ_64K, granule);
+
+	iommu_unmap(domain, start, end - start);
+}
+#endif
+
 arch_initcall(iommu_dma_init);
